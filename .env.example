# Base URL of the TRC Contractors System API (see ../TRC Contractors React),
# used server-side to fetch published journal articles for /blog. Not
# exposed to the browser — only Server Components read this.
TRC_SYSTEM_API_URL=https://trc-system.shelvinjoe11.workers.dev
NEXT_PUBLIC_GA_ID=

# Secure project portal destination. Set this to the custom app domain once
# app.trccontractors.org is attached to the production portal worker.
NEXT_PUBLIC_PORTAL_URL=https://app.trccontractors.org/
